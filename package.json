    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "0.28.2",
    "tsx": "^4.22.3",
    "typescript": "~5.8.2",
    "vite": "6.4.6"
